# EAS Build runs its own fresh `npm install` inside a remote container from
# the uploaded project source (package.json/package-lock.json only —
# node_modules is never uploaded), independent of whatever install command
# ran in CI beforehand. That remote install has no --legacy-peer-deps flag
# unless configured here, so it hits the same real peer-dependency
# conflicts documented in .github/workflows/mobile-build-android.yml
# (react-dom resolving newer than react-native's pinned react version,
# react-native-worklets' peer range vs. expo-modules-core). npm reads
# .npmrc automatically for both `npm install` and `npm ci`, so this makes
# EAS's remote install behave the same as the one already validated
# locally and in CI.
legacy-peer-deps=true
