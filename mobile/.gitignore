# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (CI writes a plain .env at build time — never commit it)
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Firebase Cloud Messaging config for Android device push. Not secret (it
# holds public project identifiers), but whether to commit it is the repo
# owner's call — app.config.js wires it up only when present, so the build
# works either way. See README.md, "Enabling device push".
google-services.json
