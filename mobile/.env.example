# Firebase web app config — same Firebase project as the web app (src/firebase.js).
# Expo inlines any EXPO_PUBLIC_ var into the JS bundle at build time — treat as public,
# same caveat as VITE_ vars in the web app's .env.example.
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Same Vercel-hosted api/ the web app calls (api/data.js + api/_lib/handlers/*.js).
EXPO_PUBLIC_API_ORIGIN=https://investor-circle.vercel.app

# Sentry (crash/error reporting) — see index.js. DSN is meant to be public
# (it's embedded in the client bundle by design), unlike SENTRY_AUTH_TOKEN
# below, which must never go in this file or be committed anywhere.
EXPO_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Build-time only — used by the Sentry Expo plugin (app.json) to upload
# readable (symbolicated) source maps during `eas build`, never inlined
# into the app bundle. Get these from sentry.io: Settings > Auth Tokens
# for the token (needs project:releases + org:read scopes), and the
# org/project slugs from your project's URL (sentry.io/organizations/
# <org>/projects/<project>/).
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
