# Firebase web app config — same Firebase project as the web app (src/firebase.js).
# Expo inlines any EXPO_PUBLIC_ var into the JS bundle at build time — treat as public,
# same caveat as VITE_ vars in the web app's .env.example.
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id

# Same Vercel-hosted api/ the web app calls (api/data.js + api/_lib/handlers/*.js).
EXPO_PUBLIC_API_ORIGIN=https://investor-circle.vercel.app

# Google sign-in (OPTIONAL). Leave unset to ship without it — the app hides
# the "Continue with Google" button entirely when these are absent, so
# email/password sign-in is unaffected. Create the client IDs in the Google
# Cloud console for the SAME project as Firebase, then add the Android client
# with package com.myinvestorcircle.app and your signing certificate's SHA-1.
#
# These are client IDs, not secrets — they are visible in the redirect URL of
# any OAuth flow, and the PKCE installed-app flow used here has no client
# secret. Never add a client secret to an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
