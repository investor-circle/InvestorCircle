# ── Firebase (authentication) ──────────────────────────────────────────────────
# Get these from: Firebase Console → Project Settings → Your apps → Web app config
# See src/firebase.js for setup instructions.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ── Vercel API proxy ───────────────────────────────────────────────────────────
# Your Vercel project's deployment URL — used by the frontend to call
# /api/email and /api/push. Both vars should point to the same Vercel project.
# VITE_CAS_API_URL takes precedence; VITE_PRICE_API_URL is the legacy name.
VITE_CAS_API_URL=https://investor-circle-pofu6hf7k-ag-bytes-projects.vercel.app
VITE_PRICE_API_URL=investor-circle-pofu6hf7k-ag-bytes-projects.vercel.app

# ── Web Push / VAPID (mobile & desktop push notifications) ────────────────────
# Generate a key pair ONCE and store both values as secrets. Never regenerate
# unless you intentionally want to invalidate all existing subscriptions.
#
# Generate with:  npx web-push generate-vapid-keys
#
# VITE_VAPID_PUBLIC_KEY  → add as GitHub Actions secret AND as Vercel env var
# VAPID_PRIVATE_KEY      → Vercel env var ONLY (never expose in the frontend)
# VAPID_EMAIL            → Vercel env var ONLY
# DATABASE_URL           → Vercel env var ONLY (use the POOLED connection string)
#
# The public key is baked into the frontend bundle at build time.
# The private key + email are used server-side only in api/push.js.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# ── Vercel-only env vars (server-side — set in Vercel dashboard, NOT here) ────
# These are NOT prefixed with VITE_ because they must never be exposed to the
# browser. Set them in: Vercel dashboard → Project → Settings → Environment Variables
#
# VAPID_PUBLIC_KEY  = <same value as VITE_VAPID_PUBLIC_KEY above>
# VAPID_PRIVATE_KEY = <your generated private key>
# VAPID_EMAIL       = mailto:hello@myinvestorcircle.com
# DATABASE_URL      = <POOLED Neon connection string, from Neon dashboard with
#                     "Connection pooling" toggled ON>
# TWELVE_DATA_KEY  = <optional Twelve Data API key; the fallback market-data
#                     provider after Yahoo Finance. Server-side only — read by
#                     api/_lib/priceProvider.js, never shipped to the browser.
#                     ALSO set as a GitHub Actions secret of the same name, for
#                     the nightly price batch (scripts/stamp-prices.js), which
#                     imports the same provider module.>
#
# There is NO CRON_SECRET any more. It existed solely to authorise the Vercel
# Cron instrument-price collector (/api/data?resource=pricing&action=collect),
# which has been retired — all price writing now happens in the nightly GitHub
# Actions batch (scripts/stamp-prices.js), which authenticates to Neon with the
# NEON_DATABASE_URL Actions secret. The pricing API is read-only.
# FIREBASE_SERVICE_ACCOUNT_JSON = <full JSON of a Firebase service account key
#                     (Firebase Console → Project Settings → Service Accounts →
#                     Generate new private key). Already used by api/reset.py;
#                     also used by api/profile/me.js for server-side ID token
#                     verification.>
