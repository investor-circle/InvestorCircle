{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/stock/:symbol", "destination": "/api/data?resource=seo&page=stock&symbol=:symbol" },
    { "source": "/sitemap.xml", "destination": "/api/data?resource=sitemap" },

    { "source": "/security/:symbol", "destination": "https://investorcircle-public.vercel.app/security/:symbol" },
    { "source": "/idea/:id", "destination": "https://investorcircle-public.vercel.app/idea/:id" },
    { "source": "/search", "destination": "https://investorcircle-public.vercel.app/search" },
    { "source": "/", "destination": "https://investorcircle-public.vercel.app/" },

    { "source": "/_wpub-static/:path+", "destination": "https://investorcircle-public.vercel.app/_wpub-static/:path+" },

    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(data|price|push|cas|email|reset|profile)(.*)",
      "missing": [
        { "type": "query", "key": "resource", "value": "seo" },
        { "type": "query", "key": "resource", "value": "sitemap" }
      ],
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" },
        { "key": "Cache-Control",                "value": "s-maxage=0, no-cache" }
      ]
    }
  ]
}
